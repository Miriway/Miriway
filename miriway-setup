    done
}

write_file()
{
    local target="$1"
    local generator="$2"

    if [ "$dry_run" -eq 1 ]; then
        echo
        echo "===== $target ====="
        "$generator"
        return
    fi

    mkdir -p "$(dirname "$target")"

    if [ -e "$target" ]; then
        if [ "$force" -eq 0 ]; then
            if ! ask_yes_no "Replace existing $target?" n; then
                echo "Skipping $target"
                return
            fi
        fi

        if [ "$backup" -eq 1 ]; then
            cp "$target" "$target.backup-$(date +%Y%m%d-%H%M%S)"
        fi
    fi

    "$generator" > "$target"
}

parse_args()
{
    while [ "$#" -gt 0 ]
    do
        case "$1" in
            --profile)
                [ "$#" -gt 1 ] || error "--profile requires a value"
                profile="$2"
                interactive=0
                shift 2
                ;;
            --list-profiles)
                list_profiles
                exit 0
                ;;
            --config-dir)
                [ "$#" -gt 1 ] || error "--config-dir requires a value"
                config_dir="$2"
                shift 2
                ;;
            --background)
                [ "$#" -gt 1 ] || error "--background requires a value"
                background="$2"
                shift 2
                ;;
            --terminal)
                [ "$#" -gt 1 ] || error "--terminal requires a value"
                terminal="$2"
                shift 2
                ;;
            --launcher)
                [ "$#" -gt 1 ] || error "--launcher requires a value"
                launcher="$2"
                shift 2
                ;;
            --panel)
                [ "$#" -gt 1 ] || error "--panel requires a value"
                panel="$2"
                shift 2
                ;;
            --notifications)
                [ "$#" -gt 1 ] || error "--notifications requires a value"
                notifications="$2"
                shift 2
                ;;
            --lockscreen)
                [ "$#" -gt 1 ] || error "--lockscreen requires a value"
                lockscreen="$2"
                shift 2
                ;;
            --install)
                install_mode=yes
                interactive=0
                shift
                ;;
            --no-install)
                install_mode=no
                interactive=0
                shift
                ;;
            --backup)
                backup=1
                shift
                ;;
            --no-backup)
                backup=0
                shift
                ;;
            --force)
                force=1
                interactive=0
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                error "unknown option: $1"
                ;;
        esac
    done
}

interactive_setup()
{
    local selected

    echo "Welcome to Miriway setup."
    echo

    selected="$(choose_from "Choose a profile:" \
        "minimal - minimal Miriway configuration" \
        "desktop - generic desktop-like setup" \
        "mate - MATE-friendly setup" \
        "xfce - XFCE-friendly setup" \
        "lxqt - LXQt-friendly setup" \
        "budgie - Budgie-friendly setup" \
        "sway - Sway-like setup")"

    profile="${selected%% *}"
}

main()
{
    local package_manager
    local missing_commands=()
    local command_name

    parse_args "$@"

    if [ -z "$profile" ]; then
        interactive_setup
    fi

    valid_profile "$profile" || error "unknown profile: $profile"

    apply_profile_defaults

    background="$(default_background)"

    if [ "$use_unsnap" = ask ]; then
        if ask_yes_no "Use miriway-unsnap when launching desktop applications?" y; then
            use_unsnap=yes
        else
            use_unsnap=no
        fi
    fi

    if [ "$use_systemd_run" = ask ]; then
        if has systemd-run && ask_yes_no "Use systemd-run for background shell components?" y; then
            use_systemd_run=yes
        else
            use_systemd_run=no
        fi
    fi

    echo
    profile_summary
    echo

    while read -r command_name
    do
        if ! has "$command_name"; then
            missing_commands+=("$command_name")
        fi
    done < <(collect_required_commands)

    if [ "${#missing_commands[@]}" -gt 0 ]; then
        echo "Missing commands:"
        printf '  %s\n' "${missing_commands[@]}"
        echo

        package_manager="$(detect_package_manager)"

        case "$install_mode" in
            yes)
                install_missing_packages "$package_manager" "${missing_commands[@]}"
                ;;
            no)
                ;;
            ask)
                if ask_yes_no "Install missing packages?" y; then
                    install_missing_packages "$package_manager" "${missing_commands[@]}"
                fi
                ;;
        esac
    fi

    write_file "$config_dir/miriway-shell.config" generate_config
    write_file "$config_dir/miriway-shell.settings" generate_settings

    if [ "$panel" = yambar ]; then
        write_file "$config_dir/yambar/config.yml" generate_yambar_config
    fi

    if [ "$dry_run" -eq 0 ]; then
        echo
        echo "Miriway setup complete."
        echo "Configuration written under: $config_dir"
    fi
}

main "$@"